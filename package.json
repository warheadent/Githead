{
  "name": "githead",
  "version": "0.1.0",
  "description": "A lightweight Windows desktop GUI for common git sync commands.",
  "main": "dist/main/main/main.js",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build:main": "tsc -p tsconfig.electron.json",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.electron.json && tsc --noEmit -p tsconfig.tests.json",
    "test": "vitest run",
    "build": "npm run build:main && vite build",
    "package:win": "npm run build && node scripts/package-win.mjs"
  },
  "keywords": [
    "electron",
    "git",
    "windows"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "25.6.0",
    "electron": "41.5.0",
    "electron-builder": "26.8.1",
    "typescript": "6.0.3",
    "vite": "8.0.10",
    "vitest": "4.1.5"
  },
  "build": {
    "appId": "com.githead.gui",
    "productName": "Githead",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": "dir",
      "signAndEditExecutable": false
    }
  },
  "dependencies": {
    "highlight.js": "^11.11.1"
  }
}
