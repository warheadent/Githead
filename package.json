{
  "name": "githead",
  "version": "0.54.0",
  "description": "A lightweight desktop GUI for common git sync commands.",
  "main": "dist/main/main/main.js",
  "private": true,
  "packageManager": "npm@11.16.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^22.22.2 || >=24.15.0",
      "onFail": "download"
    }
  },
  "homepage": "https://github.com/warheadent/Githead#readme",
  "bugs": {
    "url": "https://github.com/warheadent/Githead/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/warheadent/Githead.git"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:inspect": "node scripts/dev.mjs --remote-debugging-port=9222",
    "build:main": "vp run types:main && node scripts/clean-build.mjs main && vp run bundle:main",
    "build:renderer": "node scripts/clean-build.mjs renderer && vp run bundle:renderer",
    "typecheck": "vp run types:renderer && vp run types:main && vp run types:tests",
    "test": "vp test",
    "test:perf": "vp test src/main/performanceDiagnostics.test.ts src/main/performanceContracts.test.ts src/main/instrumentedProcessRunner.test.ts scripts/verify-package.test.mjs --run",
    "bench:perf": "vp test bench src/renderer/performance.bench.ts --run",
    "build": "vp run build:main && vp run build:renderer",
    "check": "vp check && vp run typecheck && vp test",
    "package:verify": "node scripts/verify-package.mjs",
    "version:bump": "node scripts/version-bump.mjs",
    "version:patch": "node scripts/version-bump.mjs patch",
    "version:minor": "node scripts/version-bump.mjs minor",
    "version:major": "node scripts/version-bump.mjs major",
    "package:win": "vp run build && node scripts/package-win.mjs",
    "package:win:dir": "vp run build && node scripts/package-win.mjs --dir",
    "package:linux": "vp run build && node scripts/package-linux.mjs",
    "package:linux:dir": "vp run build && node scripts/package-linux.mjs --dir",
    "icons:generate": "electron scripts/generate-app-icons.mjs"
  },
  "keywords": [
    "electron",
    "git",
    "windows",
    "linux"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@electron/asar": "4.3.0",
    "@fontsource-variable/fira-code": "^5.3.0",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/roboto": "^5.3.0",
    "@fontsource-variable/source-code-pro": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@sentry/vite-plugin": "^5.4.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "@tailwindcss/vite": "^4.3.3",
    "ansi_up": "^6.0.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "effect": "4.0.0-beta.102",
    "electron": "44.1.1",
    "electron-builder": "26.15.3",
    "highlight.js": "^11.12.0",
    "jsdom": "^30.0.1",
    "lucide-react": "^1.39.0",
    "mermaid": "^11.17.2",
    "motion": "^13.2.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.12.3",
    "remark-gfm": "^4.0.1",
    "smol-toml": "^1.8.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tslib": "^2.8.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.0",
    "vite-plus": "0.3.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.0"
  },
  "build": {
    "appId": "com.githead.gui",
    "productName": "Githead",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "!**/*.map",
      "!**/*.d.ts",
      "!**/*.d.cts",
      "!**/*.d.mts",
      "package.json",
      "resources/icon.png",
      "resources/icon.ico",
      "resources/icon.LICENSE"
    ],
    "electronLanguages": [
      "en-US"
    ],
    "publish": [
      {
        "provider": "generic",
        "url": "https://github.com/warheadent/Githead/releases/latest/download"
      }
    ],
    "win": {
      "target": "nsis",
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}",
      "icon": "resources/icon.ico",
      "signExecutable": false
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "category": "Development",
      "synopsis": "Lightweight Git GUI",
      "description": "A lightweight desktop GUI for common git sync commands.",
      "maintainer": "Githead",
      "vendor": "Githead",
      "icon": "resources/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "resources/icon.ico",
      "uninstallerIcon": "resources/icon.ico"
    },
    "icon": "resources/icon.png"
  },
  "dependencies": {
    "@sentry/electron": "^7.18.0",
    "electron-updater": "^6.8.9",
    "yaml": "^2.9.0"
  },
  "allowScripts": {
    "@sentry/cli@2.58.6": true,
    "electron@44.1.1": true,
    "electron-winstaller@5.4.0": true,
    "msgpackr-extract@3.0.4": true
  }
}
