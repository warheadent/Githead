{
  "name": "githead",
  "version": "0.12.0",
  "description": "A lightweight desktop GUI for common git sync commands.",
  "main": "dist/main/main/main.js",
  "private": true,
  "homepage": "https://github.com/warheadent/Githead#readme",
  "bugs": {
    "url": "https://github.com/warheadent/Githead/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/warheadent/Githead.git"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build:main": "tsc -p tsconfig.electron.json",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.electron.json && tsc --noEmit -p tsconfig.tests.json",
    "test": "vitest run",
    "build": "npm run build:main && vite build",
    "version:bump": "node scripts/version-bump.mjs",
    "version:patch": "node scripts/version-bump.mjs patch",
    "version:minor": "node scripts/version-bump.mjs minor",
    "version:major": "node scripts/version-bump.mjs major",
    "package:win": "npm run build && node scripts/package-win.mjs",
    "package:win:dir": "npm run build && node scripts/package-win.mjs --dir",
    "package:linux": "npm run build && node scripts/package-linux.mjs",
    "package:linux:dir": "npm run build && node scripts/package-linux.mjs --dir"
  },
  "keywords": [
    "electron",
    "git",
    "windows",
    "linux"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "25.6.0",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "electron": "41.5.0",
    "electron-builder": "26.8.1",
    "jsdom": "^29.1.1",
    "typescript": "6.0.3",
    "vite": "8.0.10",
    "vitest": "4.1.5"
  },
  "build": {
    "appId": "com.githead.gui",
    "productName": "Githead",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "publish": [
      {
        "provider": "generic",
        "url": "https://github.com/warheadent/Githead/releases/latest/download"
      }
    ],
    "win": {
      "target": "nsis",
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}",
      "signAndEditExecutable": false
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "category": "Development",
      "synopsis": "Lightweight Git GUI",
      "description": "A lightweight desktop GUI for common git sync commands.",
      "maintainer": "Githead",
      "vendor": "Githead"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "ansi_up": "^6.0.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.3",
    "highlight.js": "^11.11.1",
    "lucide-react": "^1.17.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.11.2",
    "smol-toml": "^1.6.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "tslib": "^2.8.1",
    "tw-animate-css": "^1.4.0"
  }
}
