{
  "name": "githead",
  "version": "0.36.0",
  "description": "A lightweight desktop GUI for common git sync commands.",
  "main": "dist/main/main/main.js",
  "private": true,
  "packageManager": "npm@11.16.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^22.18.0 || >=24.11.0",
      "onFail": "download"
    }
  },
  "homepage": "https://github.com/warheadent/Githead#readme",
  "bugs": {
    "url": "https://github.com/warheadent/Githead/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/warheadent/Githead.git"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:inspect": "node scripts/dev.mjs --remote-debugging-port=9222",
    "build:main": "tsc --noEmit -p tsconfig.electron.json && vp build --config vite.main.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.electron.json && tsc --noEmit -p tsconfig.tests.json",
    "test": "vp test",
    "build": "vp run build:main && vp build",
    "check": "vp check && vp run typecheck && vp test",
    "version:bump": "node scripts/version-bump.mjs",
    "version:patch": "node scripts/version-bump.mjs patch",
    "version:minor": "node scripts/version-bump.mjs minor",
    "version:major": "node scripts/version-bump.mjs major",
    "package:win": "vp run build && node scripts/package-win.mjs",
    "package:win:dir": "vp run build && node scripts/package-win.mjs --dir",
    "package:linux": "vp run build && node scripts/package-linux.mjs",
    "package:linux:dir": "vp run build && node scripts/package-linux.mjs --dir"
  },
  "keywords": [
    "electron",
    "git",
    "windows",
    "linux"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "effect": "4.0.0-beta.102",
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "jsdom": "^29.1.1",
    "typescript": "6.0.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.7",
    "vite-plus": "0.2.7"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.7"
  },
  "build": {
    "appId": "com.githead.gui",
    "productName": "Githead",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "publish": [
      {
        "provider": "generic",
        "url": "https://github.com/warheadent/Githead/releases/latest/download"
      }
    ],
    "win": {
      "target": "nsis",
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}",
      "signAndEditExecutable": false
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "category": "Development",
      "synopsis": "Lightweight Git GUI",
      "description": "A lightweight desktop GUI for common git sync commands.",
      "maintainer": "Githead",
      "vendor": "Githead"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@fontsource-variable/fira-code": "^5.3.0",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/roboto": "^5.3.0",
    "@fontsource-variable/source-code-pro": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "ansi_up": "^6.0.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.9",
    "highlight.js": "^11.11.1",
    "lucide-react": "^1.28.0",
    "mermaid": "^11.16.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.12.2",
    "remark-gfm": "^4.0.1",
    "smol-toml": "^1.7.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tslib": "^2.8.1",
    "tw-animate-css": "^1.4.0"
  },
  "allowScripts": {
    "electron@43.2.0": true,
    "electron-winstaller@5.4.0": true
  }
}
